{
    "name": "portfolio",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "browserslist": [
        "defaults and supports es6-module",
        "not dead",
        "not op_mini all"
    ],
    "scripts": {
        "clean": "rm -rf .nuxt .nuxt-build .output .nitro node_modules/.vite node_modules/.cache",
        "dev": "nuxt dev --host 0.0.0.0",
        "generate": "npm run prepare:assets && nuxt prepare --envName development && nuxt generate",
        "postgenerate": "node scripts/dedupe-inline-styles.mjs && node scripts/generate-legacy-redirects.mjs",
        "deploy": "ANALYTICS_ENABLED=true npm run generate && npm run check:site -- --analytics && gh-pages -d .output/public -b gh-pages --nojekyll",
        "postinstall": "npm run prepare:assets && nuxt prepare",
        "prepare:assets": "node scripts/prepare-content.mjs && node scripts/prepare-media.mjs && node scripts/generate-search-assets.mjs",
        "predev": "npm run prepare:assets",
        "check:site": "node scripts/check-site.mjs"
    },
    "dependencies": {
        "gsap": "^3.15.1",
        "nuxt": "^3.21.11",
        "vue": "^3.5.45"
    },
    "devDependencies": {
        "@types/node": "^22.20.2",
        "gh-pages": "^6.3.0",
        "sass": "^1.80.4",
        "sharp": "^0.35.5"
    }
}
