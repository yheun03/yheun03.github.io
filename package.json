{
    "name": "portfolio",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "browserslist": [
        "defaults and supports es6-module",
        "not dead",
        "not op_mini all"
    ],
    "scripts": {
        "clean": "rm -rf .nuxt .output .nitro node_modules/.vite node_modules/.cache",
        "dev": "nuxt dev --host 0.0.0.0",
        "generate": "nuxt generate",
        "postgenerate": "node scripts/generate-legacy-redirects.mjs",
        "deploy": "ANALYTICS_ENABLED=true npm run generate && gh-pages -d .output/public -b gh-pages --nojekyll",
        "postinstall": "nuxt prepare"
    },
    "dependencies": {
        "@fontsource/roboto-slab": "^5.2.8",
        "nuxt": "^3.14.1593",
        "vue": "^3.5.12"
    },
    "devDependencies": {
        "@types/node": "^22.20.2",
        "gh-pages": "^6.3.0",
        "sass": "^1.80.4"
    }
}
