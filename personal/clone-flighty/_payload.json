[{"data":1,"prerenderedAt":82},["ShallowReactive",2],{"work-ko-personal-clone-flighty":3,"navigation-ko-personal":53},{"id":4,"category":5,"title":6,"period":7,"type":8,"role":9,"tech":10,"introduction":18,"myWorks":19,"achievements":25,"points":28,"pin":32,"duration":33,"captures":34,"thumbnail":35,"languages":39,"links":40,"captureLabels":47,"mockup":52},"clone-flighty","personal","플라이티 UI 클론","2026.10 말 완료","개인 \u002F Vue 웹 퍼블리싱","기획 \u002F 디자인 분석 \u002F Figma 재설계 \u002F 프론트엔드 개발 전체 담당",[11,12,13,14,15,16,17],"Vue 3","JavaScript","Vue Router","Vite","SCSS","MapLibre","Figma","Flighty의 주요 화면을 Vue 3로 구현한 클론입니다. 32편의 항공 데이터로 목록, 상세, 검색, 지도, 패스포트, 통계 화면을 연결하고, 반응형과 다국어, 단위 설정을 적용했습니다.",[20,21,22,23,24],"Flighty 4.8.2 PC 버전 화면을 캡처하고 정보 구조, 폰트 계층, 카드 구성, 인터랙션 밀도를 분석","Figma 최종 시안을 기준으로 Vue 3, Vite, Vue Router 기반의 반응형 화면과 공통 UI 컴포넌트 구현","32편의 항공 데이터를 공통 JSON으로 연결해 목록, 상세, 검색, 패스포트, 통계 화면의 데이터를 일관되게 구성","MapLibre, OpenFreeMap으로 항공 경로 지도를 구현하고 검색, 기간 선택, 상세 항공편에 따라 지도 데이터를 연동","한국어, 영어, 일본어, 기기 언어와 거리, 속도, 고도 단위 설정을 브라우저에 저장해 전체 화면에 적용",[26,27],"항공편 원천 데이터를 중심으로 시간, 지연, 시차, 통계를 계산해 여러 화면이 동일한 결과를 공유하도록 구현","기본 UI와 플라이티 전용 조합 컴포넌트를 분리하고 props 변형으로 재사용 가능한 퍼블리싱 구조 완성",[29,30,31],"32편의 항공 데이터를 여러 화면에서 사용","검색, 기간별 항로 지도와 기체 정보","반응형, 4개 언어, 단위 변환",true,"",[35,36,37,38],"\u002Fassets\u002Fimages\u002Fprojects\u002Fclone-flighty\u002Fcaptures\u002Fclone-flighty-desktop.webp","\u002Fassets\u002Fimages\u002Fprojects\u002Fclone-flighty\u002Fcaptures\u002Fclone-flighty-passport.webp","\u002Fassets\u002Fimages\u002Fprojects\u002Fclone-flighty\u002Fcaptures\u002Fclone-flighty-tablet.webp","\u002Fassets\u002Fimages\u002Fprojects\u002Fclone-flighty\u002Fcaptures\u002Fclone-flighty-mobile.webp",[11,12,13,14,15,16],[41,44],{"label":42,"href":43},"페이지 이동하기","https:\u002F\u002Fyheun03.github.io\u002FcloneFlighty\u002F",{"label":45,"href":46},"GitHub","https:\u002F\u002Fgithub.com\u002Fyheun03\u002FcloneFlighty",[48,49,50,51],"항공편 목록과 경로 지도","패스포트와 전체 비행 경로","태블릿 패스포트","모바일 패스포트",{"desktop